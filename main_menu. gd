extends Control

# Reference your buttons (adjust the paths if your node names are different)
onready var ludo_btn = $ScrollContainer/HBOXCONTAINER/LUDO
onready var whot_btn = $ScrollContainer/HBOXCONTAINER/WHOT
onready var draft_btn = $ScrollContainer/HBOXCONTAINER/DRAFT

func _ready():
	print("Naija Classic menu loaded successfully!")
	
	# Connect each button's press signal to our functions below
	ludo_btn.connect("pressed", self, "_on_ludo_pressed")
	whot_btn.connect("pressed", self, "_on_whot_pressed")
	draft_btn.connect("pressed", self, "_on_draft_pressed")

func _on_ludo_pressed():
	print("Ludo button tapped! Loading Ludo...")
	# Later, you can load your Ludo scene here using: get_tree().change_scene("res://ludo.tscn")

func _on_whot_pressed():
	print("Whot button tapped! Loading Whot...")
	# Later, you can load your Whot scene here

func _on_draft_pressed():
	print("Draft button tapped! Loading Drafts...")
	# Later, you can load your Drafts scene here
